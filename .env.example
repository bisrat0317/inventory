# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=inventory_system_secure_session_secret_key_2026

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=inventory_db

# Optional Database Connection String URL (takes precedence if set)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory_db

# Email / SMTP Automated Backup Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="MEDEBER Backup" <your_email@gmail.com>
BACKUP_EMAIL=recipient_email@gmail.com
